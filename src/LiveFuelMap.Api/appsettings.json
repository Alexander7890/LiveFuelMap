{
  "ConnectionStrings": {
    "Default": "server=localhost;port=3306;database=LiveFuelMapAspNet;user=root;password=root;SslMode=None;AllowPublicKeyRetrieval=True;"
  },
  "Jwt": {
    "Issuer": "LiveFuelMap",
    "Audience": "LiveFuelMap.Frontend",
    "Algorithm": "HS256",
    "Secret": "change_me_change_me_change_me_change_me_32_chars",
    "SecretIsBase64": false,
    "PrivateKeyPath": "",
    "PublicKeyPath": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Parser": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "IntervalSeconds": 300,
    "RetentionDays": 90,
    "RunOnStartup": true
  },
  "Frontend": {
    "ApiBaseUrl": "http://localhost:5000",
    "GoogleMapsApiKey": ""
  },
  "Ai": {
    "Provider": "Ollama",
    "Model": "mistral",
    "Endpoint": "http://localhost:11434/api/generate",
    "TimeoutSeconds": 60
  },
  "Chat": {
    "RateLimitPerMinute": 20,
    "MaxMessageLength": 1000
  },
  "ApiSecurity": {
    "RateLimit": {
      "Enabled": true,
      "ReadPermitLimit": 120,
      "WritePermitLimit": 40,
      "WindowSeconds": 60,
      "QueueLimit": 20
    },
    "Idempotency": {
      "Enabled": true,
      "HeaderName": "Idempotency-Key",
      "KeyTtlMinutes": 60,
      "MaxKeyLength": 128,
      "MaxBodyBytes": 1048576
    }
  },
  "ExternalContext": {
    "Enabled": true,
    "NominatimEndpoint": "https://nominatim.openstreetmap.org/search",
    "OsrmEndpoint": "https://router.project-osrm.org",
    "DuckDuckGoEndpoint": "https://api.duckduckgo.com/",
    "DuckDuckGoHtmlEndpoint": "https://html.duckduckgo.com/html/",
    "NbuExchangeEndpoint": "https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange",
    "MinfinFuelEndpoint": "https://index.minfin.com.ua/ua/markets/fuel/reg/harkovskaya/",
    "UserAgent": "LiveFuelMap/1.0 local diploma project",
    "TimeoutSeconds": 15
  },
  "Email": {
    "UseSmtp": false,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "From": "noreply@livefuelmap.local",
      "User": "",
      "Password": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
