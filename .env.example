# LiveFuelMap development environment.
# Copy this file to .env and fill local values. Do not commit .env.

# Server
PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=livefuelmap
DB_PASSWORD=change_me
DB_NAME=LiveFuelMapAspNet

# JWT
Jwt__Issuer=LiveFuelMap
Jwt__Audience=LiveFuelMap.Frontend
Jwt__Algorithm=HS256
Jwt__Secret=change_me_change_me_change_me_change_me_32_chars
Jwt__SecretIsBase64=false
Jwt__PrivateKeyPath=
Jwt__PublicKeyPath=
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

# Google OAuth 2.0
GoogleAuth__ClientId=
GoogleAuth__ClientSecret=
GoogleAuth__RedirectUri=http://localhost:5000/api/auth/google/callback
GoogleAuth__FrontendCallbackUrl=http://localhost:5173/auth/google/callback

# reCAPTCHA v2 checkbox
Captcha__Enabled=false
Captcha__Provider=RecaptchaV2
Captcha__SiteKey=
Captcha__SecretKey=
Captcha__VerifyEndpoint=https://www.google.com/recaptcha/api/siteverify

# Auth rate limiting
AuthRateLimit__Enabled=true
AuthRateLimit__LoginAttemptLimit=8
AuthRateLimit__RegisterAttemptLimit=5
AuthRateLimit__WindowSeconds=300

# Parser
Parser__Enabled=true
Parser__IntervalMinutes=60
Parser__IntervalSeconds=300
Parser__RetentionDays=90
Parser__RunOnStartup=true
MINFIN_FUEL_ENDPOINT=https://index.minfin.com.ua/ua/markets/fuel/reg/harkovskaya/

# Frontend URLs used by backend redirects/links
Frontend__ApiBaseUrl=http://localhost:5000
Frontend__GoogleMapsApiKey=

# Frontend public browser and Capacitor WebView config. These values are exposed in Vite builds.
VITE_API_BASE_URL=http://localhost:5000
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/fuel
VITE_GOOGLE_MAPS_API_KEY=
VITE_ADMIN_CONTACT_EMAIL=livefuelmap@gmail.com
VITE_ADMIN_CONTACT_PHONE=
VITE_CAPTCHA_ENABLED=false
VITE_CAPTCHA_PROVIDER=RecaptchaV2
VITE_CAPTCHA_SITE_KEY=

# AI chat
AI_PROVIDER=Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_TIMEOUT=30
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=400
CHAT_RATE_LIMIT=20
CHAT_MAX_MESSAGE_LENGTH=1000

# Public API protection
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_READ_PER_MINUTE=120
API_RATE_LIMIT_WRITE_PER_MINUTE=40
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_QUEUE_LIMIT=20
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_HEADER_NAME=Idempotency-Key
IDEMPOTENCY_TTL_MINUTES=60
IDEMPOTENCY_MAX_BODY_BYTES=1048576

# External context providers for AI answers
EXTERNAL_CONTEXT_ENABLED=true
EXTERNAL_CONTEXT_TIMEOUT=15
EXTERNAL_CONTEXT_USER_AGENT=LiveFuelMap/1.0 local diploma project
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
OSRM_ENDPOINT=https://router.project-osrm.org
DUCKDUCKGO_ENDPOINT=https://api.duckduckgo.com/
DUCKDUCKGO_HTML_ENDPOINT=https://html.duckduckgo.com/html/
NBU_EXCHANGE_ENDPOINT=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange

# Email
Email__UseSmtp=false
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__UseSsl=true
Email__Smtp__From=noreply@livefuelmap.local
Email__Smtp__User=
Email__Smtp__Password=
